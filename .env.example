# Any Postgres with the pgvector extension available
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_assistant
TABLE_NAME=chunks

# ollama (free, runs locally) | openai | gemini | anthropic
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:9b
# Ollama reloads a model when the context size changes; 8192 is plenty for this app
OLLAMA_CONTEXT_WINDOW=8192
OLLAMA_BASE_URL=http://localhost:11434

# ollama | openai | gemini
# A different embedding model means different vectors: use a new TABLE_NAME and re-ingest.
EMBED_PROVIDER=ollama
EMBED_MODEL=qwen3-embedding:0.6b
EMBED_DIM=1024
# Defaults to the Qwen3-Embedding retrieval instruction. Set it empty to turn it off.
# EMBED_QUERY_INSTRUCTION=

# Only the key for the provider you pick
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

TOP_K=5
SIMILARITY_CUTOFF=0.4
MAX_UPLOAD_MB=20

# For a public deployment: refuses uploads and deletes, and limits questions per IP and
# per day. The counts live in Postgres, so they hold across serverless instances.
# DEMO_MODE=true
# DEMO_MAX_QUESTION_CHARS=500
# DEMO_QUESTIONS_PER_MINUTE=5
# DEMO_QUESTIONS_PER_DAY=20
# DEMO_QUESTIONS_ALL_PER_DAY=100
